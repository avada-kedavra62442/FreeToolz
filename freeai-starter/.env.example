# Set this in Vercel Project Settings > Environment Variables.
# Never add your real key to client-side code or commit it to Git.
OPENROUTER_API_KEY=
# Optional: choose any currently available free OpenRouter model.
FREEAI_MODEL=google/gemma-4-31b-it:free
# Optional: comma-separated production origins, e.g. https://freeai-example.vercel.app
FREEAI_ALLOWED_ORIGINS=
